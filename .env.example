# ---- Frontend (exposed to the browser: never put secrets in VITE_ vars) ----
# Public site origin, used for og:image / og:url / canonical
VITE_SITE_URL=https://theseedling.in
# Backend base URL. Leave empty to call same-origin /api (dev proxy forwards it to the server below)
VITE_API_BASE=

# ---- Reference payment server (server/index.js) — secrets stay server-side ----
CASHFREE_ENV=sandbox
CASHFREE_APP_ID=your_app_id
CASHFREE_SECRET_KEY=your_secret_key
# Optional: where Cashfree sends the parent after payment. Defaults to the site the request came from.
SITE_URL=http://localhost:5173
PORT=8787

# PostHog (production values live in .env.production). Leave empty locally to send nothing.
VITE_POSTHOG_KEY=
# Optional: defaults to /ingest (proxied by vercel.json in production and vite.config.js locally)
VITE_POSTHOG_HOST=
